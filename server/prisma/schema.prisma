// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int       @id @default(autoincrement()) @db.Integer
  email             String    @unique @db.VarChar(255)
  name              String    @db.VarChar(100)
  nickname          String    @unique @db.VarChar(20)
  loginFrom         LoginFrom
  profileImageUrl   String?   @db.VarChar(500)
  refreshToken      String    @db.VarChar(500)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  pets              Pet[]
  posts             Post[]
  comments          Comment[] @relation("CommentAuthor")
  mentionedComments Comment[] @relation("CommentMention")
  consultations     Consultation[]
}

model Pet {
  id          Int       @id @default(autoincrement()) @db.Integer
  userId      Int       @db.Integer
  name        String    @db.VarChar(100)
  type        PetType
  gender      PetGender
  breed       String   @db.VarChar(100)
  weight      Decimal?  @db.Decimal(5, 2)
  birthDate   DateTime? @db.Date
  isNeutered  Boolean?
  imageUrl    String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations Consultation[]

  @@index([userId])
}

enum LoginFrom {
  KAKAO
  GOOGLE
  APPLE
}

enum PetType {
  DOG
  CAT
}

enum PetGender {
  MALE
  FEMALE
}

enum MessageRole {
  user
  assistant
}

model Category {
  id        Int      @id @default(autoincrement()) @db.Integer
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@index([name])
}

model Post {
  id         Int      @id @default(autoincrement()) @db.Integer
  userId     Int      @db.Integer
  categoryId Int      @db.Integer
  title      String   @db.VarChar(255)
  content    String   @db.Text
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  comments   Comment[]

  @@index([userId])
  @@index([categoryId])
  @@index([createdAt])
}

model Comment {
  id            Int       @id @default(autoincrement()) @db.Integer
  postId        Int       @db.Integer
  userId        Int       @db.Integer
  parentId      Int?      @db.Integer
  mentionUserId Int?      @db.Integer
  content       String    @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? @db.Timestamp
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User      @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  mentionUser   User?     @relation("CommentMention", fields: [mentionUserId], references: [id], onDelete: SetNull)
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId, createdAt])
}

model Consultation {
  id            Int                          @id @default(autoincrement()) @db.Integer
  userId        Int                          @db.Integer
  petId         Int                          @db.Integer
  title         String?                      @db.VarChar(200)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet           Pet                          @relation(fields: [petId], references: [id], onDelete: Cascade)
  conversations ConsultationConversation[]
  messages      ConsultationMessage[]

  @@index([userId])
  @@index([petId])
  @@index([createdAt])
}

model ConsultationConversation {
  id               Int                   @id @default(autoincrement()) @db.Integer
  consultationId   Int                   @db.Integer
  conversationId   String                @db.VarChar(255)
  totalInputToken  Int                   @default(0)
  totalOutputToken Int                   @default(0)
  isActive         Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  consultation     Consultation          @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([isActive])
}

model ConsultationMessage {
  id                         Int                      @id @default(autoincrement()) @db.Integer
  consultationId             Int                      @db.Integer
  role                       MessageRole
  content                    String                   @db.Text
  inputToken                 Int                      @default(0)
  outputToken                Int                      @default(0)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  consultation               Consultation             @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([createdAt])
}